# Copy this file to .env and fill in a key.
#   copy .env.example .env

GEMINI_API_KEY=your_key_here
# GOOGLE_API_KEY=your_key_here

# Choose which vision provider the agent uses. Keep Gemini here until an
# OpenAI key has been rotated and added to your local .env file.
LLM_PROVIDER=gemini

# OpenAI is optional. Never commit a real key; .env is ignored by git.
OPENAI_API_KEY=your_openai_key_here
OPENAI_MODEL=gpt-5-nano
OPENAI_MATH_MODEL=gpt-5-mini
OPENAI_GENERAL_MODEL=gpt-5-nano
# Maximum time for one OpenAI Responses API call before Viszmo tries a fallback.
OPENAI_REQUEST_TIMEOUT_SECONDS=40
# Optional OpenAI Responses API controls:
# OPENAI_REASONING_EFFORT=medium
# OPENAI_VERBOSITY=low
# Output ceilings protect cost while leaving room for the full structured plan.
# OPENAI_GENERAL_MAX_OUTPUT_TOKENS=2048
# OPENAI_MATH_MAX_OUTPUT_TOKENS=3072

# General uses the low-cost route by default. Math uses a stronger reasoning
# route because answer correctness is the priority there.
GEMINI_MODEL=gemini-3.5-flash-lite
# Maximum time for one Gemini vision request before Viszmo tries a fallback.
GEMINI_REQUEST_TIMEOUT_SECONDS=30
# Maximum time for one Chrome DevTools read before Viszmo reconnects and retries.
VISZMO_CDP_READ_TIMEOUT_SECONDS=30
# Set to 0 to disable snapping model clicks onto real page elements (fallback
# is the raw screenshot coordinates).
# VISZMO_CLICK_SNAP=1
# How many identical-frame iterations wait locally instead of paying for
# another model turn. 0 disables the local settle window.
# VISZMO_UNCHANGED_LLM_SKIPS=2
# Optional per-mode overrides:
# GEMINI_MATH_MODEL=gemini-3.7-flash
# GEMINI_GENERAL_MODEL=gemini-3.5-flash-lite
# GEMINI_MATH_THINKING_LEVEL=low
# GEMINI_GENERAL_THINKING_LEVEL=minimal
# GEMINI_GENERAL_MAX_OUTPUT_TOKENS=2048
# GEMINI_MATH_MAX_OUTPUT_TOKENS=3072
# GEMINI_INPUT_PRICE_PER_MILLION=0
# GEMINI_OUTPUT_PRICE_PER_MILLION=0
# OPENAI_INPUT_PRICE_PER_MILLION=0
# OPENAI_OUTPUT_PRICE_PER_MILLION=0

# Optional cross-provider backup for provider-wide outages. Joins the race
# only after the primary queue has been slow for VISZMO_BACKUP_DELAY_SECONDS,
# so healthy turns cost nothing extra. Requires that provider's API key.
# VISZMO_BACKUP_MODEL=openai:gpt-5-nano
# VISZMO_BACKUP_DELAY_SECONDS=14

SIDEBAR_WIDTH=380

# The dashboard launches the browser after the user clicks Launch. This flag
# only affects the older direct workspace launcher.
VISZMO_AUTO_LAUNCH_BROWSER=1
VISZMO_START_URL=https://www.google.com
VISZMO_BROWSER=auto

# Website used for desktop sign-in and the shared update manifest. Use the local
# Vite URL during development and https://www.viszmo.com for packaged releases.
VISZMO_WEBSITE_URL=https://www.viszmo.com
# Optional explicit manifest URL. The default is
# ${VISZMO_WEBSITE_URL}/updates/viszmo.json.
# VISZMO_UPDATE_MANIFEST_URL=https://www.viszmo.com/updates/viszmo.json
# Optional generic electron-updater feed. Leave unset to use the GitHub release
# provider configured in package.json. A generic feed must serve latest.yml (or
# latest-mac.yml) and the signed installer artifacts generated by electron-builder.
# VISZMO_UPDATE_URL=https://www.viszmo.com/downloads/desktop/

# Native Windows toast + sound when an assignment finishes. Set 0 to silence.
VISZMO_NOTIFICATIONS=1
